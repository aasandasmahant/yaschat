	},
	"devDependencies": {
		"@yas chat/apps-engine": "workspace:^",
		"@yas chat/ddp-client": "workspace:^",
		"@yas chat/jest-presets": "workspace:~",
		"@yas chat/media-signaling": "workspace:^",
		"@types/node": "~24.13.6",
		"jest": "~30.5.2",
		"typescript": "~7.0.2"
