{
	"name": "@yas chat/streamer",
	"version": "0.1.2",
	"private": true,
	"description": "Streamer seam, stream catalogue and broker-event listeners shared by apps/meteor and ddp-streamer",
	"keywords": [
		"yaschat"
	],
	"author": "YasChat",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
