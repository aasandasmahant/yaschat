{
	"name": "@yas chat/media-signaling",
	"description": "YasChat signaling client for media calls",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"version": "1.4.0",
	"license": "MIT",
	"homepage": "https://github.com/YasChat/YasChat/#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/YasChat/YasChat.git",
		"directory": "packages/media-signaling"
	},
	"bugs": {
		"url": "https://github.com/YasChat/YasChat/issues"
	},
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.json",
		"build-preview": "mkdir -p ../../.preview && cp -r ./dist ../../.preview/media-signaling",
		"dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
		"lint": "yarn run -T oxlint",
		"lint:fix": "yarn run -T oxlint --fix",
		"test": "jest",
		"testunit": "jest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@yas chat/emitter": "workspace:~",
		"ajv": "^8.20.0"
	},
	"devDependencies": {
		"@yas chat/jest-presets": "workspace:~",
		"@yas chat/tsconfig": "workspace:*",
		"jest": "~30.5.2",
		"typescript": "~7.0.2"
	}
}
