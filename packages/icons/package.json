{
	"name": "@yas chat/icons",
	"version": "0.52.0",
	"description": "YasChat's Icons",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./dist/*": "./dist/*"
	},
	"homepage": "https://github.com/YasChat/YasChat#readme",
	"bugs": {
		"url": "https://github.com/YasChat/YasChat/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/YasChat/YasChat.git",
		"directory": "packages/icons"
	},
	"license": "MIT",
	"author": {
		"name": "YasChat",
		"url": "https://yas chat/"
	},
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "node scripts/buildIcons.mjs",
		"lint": "yarn run -T oxlint",
		"lint:fix": "yarn run -T oxlint --fix"
	},
	"devDependencies": {
		"svg2ttf": "~6.1.0",
		"svgicons2svgfont": "~16.0.0",
		"ttf2eot": "~3.1.0",
		"ttf2woff": "~3.0.0",
		"ttf2woff2": "~8.0.1",
		"unicode": "~14.0.0",
		"xml2js": "~0.6.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"volta": {
		"extends": "../../package.json"
	}
}
