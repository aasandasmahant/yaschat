{
	"name": "@yas chat/layout",
	"version": "1.0.0",
	"description": "Shared Application Layout Components",
	"homepage": "https://github.com/YasChat/YasChat#readme",
	"bugs": {
		"url": "https://github.com/YasChat/YasChat/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/YasChat/YasChat.git",
		"directory": "packages/layout"
	},
	"license": "MIT",
	"author": {
		"name": "YasChat",
		"url": "https://yas chat/"
	},
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/esm/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json",
		"build-storybook": "storybook build",
		"lint": "yarn run -T oxlint",
		"lint:fix": "yarn run -T oxlint --fix",
		"storybook": "storybook dev -p 6006",
		"test": "jest",
		"testunit": "jest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@yas chat/fuselage-hooks": "workspace:^",
		"@yas chat/fuselage-tokens": "workspace:^",
		"@yas chat/logo": "workspace:~",
		"@yas chat/styled": "workspace:~"
	},
	"devDependencies": {
		"@yas chat/fuselage": "workspace:~",
		"@yas chat/jest-presets": "workspace:~",
		"@yas chat/storybook-config": "workspace:~",
		"@yas chat/tsconfig": "workspace:~",
		"@testing-library/dom": "~10.4.2",
		"@testing-library/react": "~16.3.3",
		"@types/react": "~19.2.18",
		"@types/react-dom": "~19.2.7",
		"i18next": "~26.4.2",
		"jest": "~30.5.2",
		"react": "~19.2.8",
		"react-dom": "~19.2.8",
		"react-i18next": "~17.0.16",
		"storybook": "~10.6.5",
		"typescript": "~7.0.2"
	},
	"peerDependencies": {
		"@yas chat/fuselage": "1.0.0",
		"react": ">=19",
		"react-dom": ">=19",
		"react-i18next": "*"
	},
	"volta": {
		"extends": "../../package.json"
	},
	"publishConfig": {
		"access": "public"
	}
}
