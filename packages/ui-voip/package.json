		"@yas chat/fuselage-hooks": "workspace:^",
		"@yas chat/fuselage-tokens": "workspace:^",
		"@yas chat/fuselage-ui-kit": "workspace:^",
		"@yas chat/icons": "workspace:~",
		"@yas chat/jest-presets": "workspace:~",
		"@yas chat/mock-providers": "workspace:~",
		"@yas chat/storybook-config": "workspace:~",
		"@yas chat/styled": "workspace:~",
		"@yas chat/tsconfig": "workspace:*",
		"@yas chat/ui-avatar": "workspace:^",
		"@yas chat/ui-client": "workspace:^",
		"@yas chat/ui-contexts": "workspace:^",
		"@yas chat/ui-kit": "workspace:^",
		"@yas chat/ui-media": "workspace:^",
		"@storybook/react": "~10.6.5",
		"@storybook/test-runner": "~0.26.0",
		"@testing-library/dom": "~10.4.2",
