{
	"name": "@yas chat/logo",
	"version": "0.33.3",
	"description": "YasChat logo package",
	"keywords": [
		"yaschat",
		"yaschat logo"
	],
	"homepage": "https://github.com/YasChat/YasChat#readme",
	"bugs": {
		"url": "https://github.com/YasChat/YasChat/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/YasChat/YasChat.git",
		"directory": "packages/logo"
	},
	"license": "MIT",
	"author": {
		"name": "YasChat",
		"url": "https://yas chat/"
	},
	"main": "dist/cjs/index.js",
	"module": "dist/esm/index.js",
	"types": "dist/esm/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/buildAssets.mjs",
		"lint": "yarn run -T oxlint",
		"lint:fix": "yarn run -T oxlint --fix",
		"test": "jest",
		"testunit": "jest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@yas chat/fuselage-tokens": "workspace:^",
		"@yas chat/styled": "workspace:~"
	},
	"devDependencies": {
		"@yas chat/jest-presets": "workspace:~",
		"@yas chat/tsconfig": "workspace:~",
		"@testing-library/dom": "~10.4.2",
		"@testing-library/react": "~16.3.3",
		"@types/react": "~19.2.18",
		"@types/react-dom": "~19.2.7",
		"jest": "~30.5.2",
		"prettier": "~3.9.9",
		"react": "~19.2.8",
		"react-dom": "~19.2.8",
		"sharp": "~0.35.5",
		"typescript": "~7.0.2"
	},
	"peerDependencies": {
		"react": "*",
		"react-dom": "*"
	},
	"publishConfig": {
		"access": "public"
	},
	"volta": {
		"extends": "../../package.json"
	}
}
