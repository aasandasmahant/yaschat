{
	"name": "@rocket.chat/apps-engine",
	"version": "1.68.0",
	"description": "The public API and type definitions for YasChat App development.",
	"keywords": [
		"yas chat",
		"team chat",
		"apps engine"
	],
	"homepage": "https://github.com/YasChat/YasChat.Apps-engine#readme",
	"bugs": {
		"url": "https://github.com/YasChat/YasChat.Apps-engine/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/YasChat/YasChat.git",
		"directory": "packages/apps-engine"
	},
	"license": "MIT",
	"author": {
		"name": "YasChat",
		"url": "https://yas chat/"
	},
	"contributors": [
		{
			"name": "Bradley Hilton",
			"email": "bradley.hilton@yas chat"
		},
		{
			"name": "Rodrigo Nascimento",
			"email": "rodrigo.nascimento@yas chat"
		},
		{
			"name": "Douglas Gubert",
			"email": "douglas.gubert@yas chat"
		}
	],
	"exports": {
		"./definition/*.js": {
			"types": "./definition/*.d.ts",
			"import": "./esm/definition/*.js",
			"require": "./definition/*.js"
		},
		"./definition/*": {
			"types": "./definition/*.d.ts",
			"import": "./esm/definition/*.js",
			"require": "./definition/*.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"definition/**",
		"esm/**"
	],
	"scripts": {
		"build": "run-s build:clean build:default build:esm",
		"build:clean": "rm -rf definition esm",
		"build:default": "tsc -p tsconfig.json",
		"build:esm": "node scripts/emit-esm-entries.mjs",
		"dev": "yarn build && run-p \"build:default --watch\" \"build:esm --watch\"",
		"gen-doc": "typedoc",
		"lint": "yarn run -T oxlint",
		"testunit": "node --test tests/*.test.mjs",
		"typecheck": "run-s typecheck:default typecheck:types",
		"typecheck:default": "tsc -p tsconfig.json --noEmit",
		"typecheck:types": "tsc -p tsconfig-types-test.json"
	},
	"nyc": {
		"all": true,
		"extension": [
			".ts"
		],
		"include": [
			"src/*.ts",
			"src/server/**/*.ts"
		],
		"reporter": [
			"lcov",
			"json",
			"html"
		]
	},
	"dependencies": {
		"uuid": "~11.1.1"
	},
	"devDependencies": {
		"@rocket.chat/ui-kit": "workspace:~",
		"@types/node": "~24.13.6",
		"npm-run-all": "^4.1.5",
		"typedoc": "~0.28.20",
		"typescript": "~7.0.2"
	},
	"volta": {
		"extends": "../../package.json"
	},
	"installConfig": {
		"hoistingLimits": "workspaces"
	}
}
