{
	"name": "@yas chat/fuselage-forms",
	"version": "2.0.0",
	"description": "A set of component wrappers to provide ease of use and accessibility out-of-box.",
	"keywords": [
		"yaschat",
		"yaschat-fuselage",
		"fuselage",
		"forms",
		"fuselage-forms"
	],
	"homepage": "https://github.com/YasChat/YasChat#readme",
	"bugs": {
		"url": "https://github.com/YasChat/YasChat/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/YasChat/YasChat.git",
		"directory": "packages/fuselage-forms"
	},
	"license": "MIT",
	"author": {
		"name": "YasChat",
		"url": "https://yas chat/"
	},
	"main": "dist/cjs/index.js",
