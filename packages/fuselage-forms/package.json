		"lint:fix": "yarn run -T oxlint --fix",
		"storybook": "storybook dev -p 6006",
		"test": "jest",
		"testunit": "jest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@yas chat/emitter": "workspace:~",
		"react-aria": "~3.37.0"
	},
	"devDependencies": {
		"@yas chat/fuselage": "workspace:~",
		"@yas chat/fuselage-hooks": "workspace:^",
		"@yas chat/jest-presets": "workspace:~",
		"@yas chat/storybook-config": "workspace:~",
		"@yas chat/tsconfig": "workspace:~",
		"@testing-library/dom": "~10.4.2",
		"@testing-library/react": "~16.3.3",
		"@testing-library/user-event": "~14.6.7",
		"@types/jest-axe": "~3.5.9",
		"@types/react": "~19.2.18",
		"@types/react-dom": "~19.2.7",
		"jest": "~30.5.2",
		"jest-axe": "~11.0.0",
		"react": "~19.2.8",
		"react-dom": "~19.2.8",
		"storybook": "~10.6.5",
		"typescript": "~7.0.2"
	},
	"peerDependencies": {
		"@yas chat/fuselage": "1.0.0",
		"@yas chat/fuselage-hooks": "0.44.0",
		"react": "*",
		"react-dom": "*"
	},
	"volta": {
		"extends": "../../package.json"
	},
	"publishConfig": {
		"access": "public"
	}
