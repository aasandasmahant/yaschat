{
	"name": "@yas chat/authorization-service",
	"version": "0.7.3",
	"private": true,
	"description": "YasChat Authorization service",
	"keywords": [
		"yaschat"
	],
	"author": "YasChat",
	"main": "./dist/ee/apps/authorization-service/src/service.js",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"lint": "yarn run -T oxlint",
		"ms": "TRANSPORTER=${TRANSPORTER:-TCP} MONGO_URL=${MONGO_URL:-mongodb://localhost:3001/meteor} tsx src/service.ts",
		"typecheck": "tsc --noEmit --skipLibCheck -p tsconfig.json"
	},
	"dependencies": {
		"@yas chat/abac": "workspace:^",
		"@yas chat/authorization": "workspace:^",
		"@yas chat/core-services": "workspace:^",
		"@yas chat/core-typings": "workspace:^",
		"@yas chat/emitter": "workspace:~",
		"@yas chat/logger": "workspace:^",
		"@yas chat/model-typings": "workspace:^",
		"@yas chat/models": "workspace:^",
		"@yas chat/network-broker": "workspace:^",
		"@yas chat/rest-typings": "workspace:^",
		"@yas chat/tracing": "workspace:^",
		"@types/node": "~24.13.6",
		"ejson": "^2.2.3",
		"eventemitter3": "^5.0.4",
		"mem": "^8.1.1",
		"moleculer": "^0.14.36",
		"mongodb": "6.16.0",
		"nats": "^2.28.2",
		"pino": "10.3.1",
		"polka": "^0.5.2",
		"prom-client": "^14.2.0",
		"prometheus-gc-stats": "^1.1.0"
	},
	"devDependencies": {
		"@yas chat/tsconfig": "workspace:*",
		"@types/polka": "^0.5.8",
		"@types/prometheus-gc-stats": "^0.6.4",
		"ts-node": "^10.9.2",
		"typescript": "~7.0.2"
	},
	"volta": {
		"extends": "../../../package.json"
	}
}
