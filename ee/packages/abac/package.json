{
	"name": "@yas chat/abac",
	"version": "0.4.0",
	"private": true,
	"description": "YasChat - Attribute Based Access Control (ABAC) support utilities",
	"main": "./dist/index.js",
	"typings": "./dist/index.d.ts",
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"dev": "tsc --watch --preserveWatchOutput",
		"lint": "yarn run -T oxlint",
		"lint:fix": "yarn run -T oxlint --fix",
		"test": "jest",
		"testunit": "jest",
		"typecheck": "tsc --noEmit --skipLibCheck"
	},
	"config": {
		"mongodbMemoryServer": {
			"downloadDir": "../../../node_modules/.cache/mongodb-memory-server",
			"preferGlobalPath": false
		}
	},
	"volta": {
		"extends": "../../../package.json"
	},
	"dependencies": {
		"@yas chat/core-services": "workspace:^",
		"@yas chat/core-typings": "workspace:^",
		"@yas chat/logger": "workspace:^",
		"@yas chat/models": "workspace:^",
		"@yas chat/server-fetch": "workspace:^",
		"@yas chat/tools": "workspace:^",
		"mem": "^8.1.1",
		"mongodb": "6.16.0",
		"p-limit": "3.1.0"
	},
	"devDependencies": {
		"@yas chat/jest-presets": "workspace:~",
		"@yas chat/rest-typings": "workspace:^",
		"@yas chat/tsconfig": "workspace:*",
		"@types/node": "~24.13.6",
		"jest": "~30.5.2",
		"mongodb-memory-server": "^10.2.3",
		"typescript": "~7.0.2"
	}
}
